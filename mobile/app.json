{
  "expo": {
    "name": "Chord Recognition",
    "slug": "chord-recognition",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "This app uses the microphone to record guitar chords for recognition.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "com.example.chordrecognition",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "usesCleartextTraffic": true
    },
    "plugins": [
      [
        "expo-av",
        {
          "microphonePermission": "Allow Chord Recognition to access your microphone."
        }
      ]
    ]
  }
}
